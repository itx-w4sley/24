# Create a MongoDB Atlas cluster, then copy this file to .env.local
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=creative_studio_5
# Generate securely with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=GENERATE_A_RANDOM_96_CHARACTER_HEX_STRING
SITE_URL=http://localhost:3000
# Used only when running npm run setup locally (do not deploy these to Vercel)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=YOUR_OWN_LONG_UNIQUE_ADMIN_PASSWORD
# Optional server-side integrations. Never prefix secret keys with NEXT_PUBLIC_
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFICATION_FROM=Studio <notifications@your-verified-domain.example>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: set to 1 and redeploy to show the maintenance screen for public pages
STUDIO_MAINTENANCE_MODE=0
